{
  "name": "WellnessInsight",
  "type": "object",
  "properties": {
    "crew_id": {
      "type": "string",
      "title": "Crew member id"
    },
    "crew_name": {
      "type": "string",
      "title": "Crew member"
    },
    "generated_on": {
      "type": "string",
      "format": "date",
      "title": "Generated on"
    },
    "status": {
      "type": "string",
      "enum": [
        "stable",
        "watch",
        "attention",
        "insufficient"
      ],
      "title": "Status"
    },
    "headline": {
      "type": "string",
      "title": "Headline"
    },
    "summary": {
      "type": "string",
      "title": "Summary"
    },
    "avg_sleep": {
      "type": "number",
      "title": "Average sleep (h)"
    },
    "sleep_debt": {
      "type": "number",
      "title": "Sleep debt (h)"
    },
    "bedtime_spread": {
      "type": "number",
      "title": "Bedtime spread (minutes)"
    },
    "entries_analyzed": {
      "type": "number",
      "title": "Entries analyzed"
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Detected patterns"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Recommended actions"
    }
  },
  "required": [
    "status",
    "headline",
    "generated_on"
  ]
}